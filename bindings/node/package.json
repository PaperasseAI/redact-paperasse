{
  "name": "redact-paperasse",
  "version": "0.1.4",
  "description": "Fast PII redaction for agents \u2014 image/PDF/text in, redacted image/PDF/text/markdown out",
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts"
  ],
  "napi": {
    "binaryName": "redact-paperasse",
    "targets": [
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-pc-windows-msvc"
    ],
    "triples": {
      "defaults": true,
      "additional": [
        "aarch64-apple-darwin",
        "aarch64-unknown-linux-gnu"
      ]
    }
  },
  "scripts": {
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform"
  },
  "devDependencies": {
    "@napi-rs/cli": "^2"
  },
  "optionalDependencies": {
    "redact-paperasse-darwin-x64": "0.1.4",
    "redact-paperasse-darwin-arm64": "0.1.4",
    "redact-paperasse-linux-x64-gnu": "0.1.4",
    "redact-paperasse-linux-arm64-gnu": "0.1.4",
    "redact-paperasse-win32-x64-msvc": "0.1.4"
  },
  "license": "MIT",
  "repository": "https://github.com/PaperasseAI/redact-paperasse"
}
